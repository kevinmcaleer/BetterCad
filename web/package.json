{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "e2e": "playwright test --trace off --grep-invert \"@visual|@quarantine|@docs\"",
    "e2e:quarantine": "playwright test --trace off --grep @quarantine --pass-with-no-tests",
    "e2e:visual": "playwright test --trace off --grep @visual",
    "size": "node scripts/bundle-report.mjs dist",
    "build:samples": "vite-node scripts/build-samples.ts",
    "build:icons": "node scripts/build-icons.mjs",
    "docs:shots": "playwright test --trace off --grep @docs"
  },
  "dependencies": {
    "@bettercad/kernel": "*",
    "@bettercad/sketch": "*",
    "@bettercad/ui": "*",
    "@fontsource/allerta-stencil": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "opentype.js": "^1.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.180.0",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.180.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
