  "id": "sample-phone-stand",
  "created": "2026-11-07T00:00:00.000Z",
  "modified": "2026-11-07T00:00:00.000Z",
  "name": "Phone stand",
  "document": {
    "features": [
      {
        "id": "f1",
        "name": "Add Phone stand",
        "part": {
          "id": "stand",
          "kind": "box",
          "name": "Phone stand",
          "position": {
            "x": 0,
            "y": 0,
            "z": 0
          },
          "size": {
            "x": 10,
            "y": 10,
            "z": 10
          }
        },
        "type": "add"
      },
      {
        "exprs": {
          "size.x": "lean + shelf + 4",
          "size.y": "width",
          "size.z": "base"
        },
        "id": "f2",
        "name": "Size Phone stand",
        "parts": [
          "stand"
        ],
        "size": {
          "x": 10,
          "y": 10,
          "z": 10
        },
        "type": "resize"
      },
      {
        "id": "f3",
        "name": "Add Back rest",
        "part": {
          "id": "rest",
          "kind": "wedge",
          "name": "Back rest",
          "position": {
            "x": 0,
            "y": 0,
            "z": 0
          },
          "size": {
            "x": 10,
            "y": 10,
            "z": 10
          }
        },
        "type": "add"
      },
      {
        "exprs": {
          "size.x": "lean",
          "size.y": "width",
          "size.z": "height"
        },
        "id": "f4",
        "name": "Size Back rest",
        "parts": [
          "rest"
        ],
        "size": {
          "x": 10,
          "y": 10,
          "z": 10
        },
        "type": "resize"
      },
      {
        "exprs": {
          "position.x": "lean / 2 - (lean + shelf + 4) / 2",
          "position.z": "base"
        },
        "id": "f5",
        "name": "Place Back rest",
        "parts": [
          "rest"
        ],
        "position": {
          "x": 0,
          "y": 0,
          "z": 0
        },
        "type": "move"
      },
      {
        "id": "f6",
        "name": "Add Lip",
        "part": {
          "id": "lip",
          "kind": "box",
          "name": "Lip",
          "position": {
            "x": 0,
            "y": 0,
            "z": 0
          },
          "size": {
            "x": 10,
            "y": 10,
            "z": 10
          }
        },
        "type": "add"
      },
      {
        "exprs": {
          "size.x": "4",
          "size.y": "width",
          "size.z": "base + 8"
        },
        "id": "f7",
        "name": "Size Lip",
        "parts": [
          "lip"
        ],
        "size": {
          "x": 10,
          "y": 10,
          "z": 10
        },
        "type": "resize"
      },
      {
        "exprs": {
          "position.x": "(lean + shelf + 4) / 2 - 2"
        },
        "id": "f8",
        "name": "Place Lip",
        "parts": [
          "lip"
        ],
        "position": {
          "x": 0,
          "y": 0,
          "z": 0
        },
        "type": "move"
      },
      {
        "id": "f9",
        "mode": "group",
        "name": "Phone stand",
        "target": "stand",
        "tools": [
          {
            "id": "rest",
            "op": "join"
          },
          {
            "id": "lip",
            "op": "join"
          }
        ],
        "type": "combine"
      }
    ],
    "format": "bettercad",
    "looks": {},
    "name": "Phone stand",
    "params": [
      {
        "comment": "Across the stand",
        "expression": "70",
        "id": "p_width",
        "name": "width",
        "unit": "mm"
      },
      {
        "comment": "How high the back rest reaches",
