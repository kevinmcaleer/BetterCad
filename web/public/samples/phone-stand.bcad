        "unit": "mm"
      },
      {
        "comment": "How far the back rest leans: the same as height is 45°, more leans further back",
        "expression": "50",
        "id": "p_lean",
        "name": "lean",
        "unit": "mm"
      },
      {
        "comment": "Room for the phone in its case",
        "expression": "14",
        "id": "p_shelf",
        "name": "shelf",
        "unit": "mm"
      },
      {
        "comment": "Base thickness",
        "expression": "4",
        "id": "p_base",
        "name": "base",
