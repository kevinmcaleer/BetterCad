        "size": {
          "x": 10,
          "y": 10,
          "z": 10
        },
        "type": "resize"
      },
      {
        "exprs": {
          "size": "wall"
        },
        "id": "f3",
        "name": "Hollow the box",
        "part": "box",
        "refs": [
          5
        ],
        "size": 2,
        "type": "shell"
      },
      {
        "id": "f4",
        "name": "Add Lid",
        "part": {
          "id": "lid",
          "kind": "box",
          "name": "Lid",
          "position": {
            "x": 0,
            "y": 0,
            "z": 0
          },
          "size": {
            "x": 10,
            "y": 10,
            "z": 10
          }
        },
