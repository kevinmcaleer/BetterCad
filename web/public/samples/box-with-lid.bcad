        ],
        "position": {
          "x": 0,
          "y": 0,
          "z": 0
        },
        "type": "move"
      },
      {
        "id": "f7",
        "name": "Add Lip",
        "part": {
          "id": "lip",
          "kind": "box",
          "name": "Lip",
          "position": {
            "x": 0,
            "y": 0,
            "z": 0
          },
          "size": {
            "x": 10,
            "y": 10,
            "z": 10
          }
        },
        "type": "add"
      },
      {
        "exprs": {
          "size.x": "width - 2 * wall - 2 * gap",
