{
  "name": "bettercad",
  "private": true,
  "version": "0.1.0",
  "description": "A free, browser-based CAD tool for 3D printing.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run tokens && tsc -b && npm run build -w web",
    "tokens": "npm run tokens -w @bettercad/ui",
    "tokens:check": "npm run tokens:check -w @bettercad/ui",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "npm run e2e -w web",
    "check": "npm run lint && npm run typecheck && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:golden": "vitest run packages/kernel/src/golden.test.ts packages/sketch/src/golden.test.ts",
    "e2e:visual": "npm run e2e:visual -w web",
    "e2e:update": "npm run e2e:visual -w web -- --update-snapshots=all"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^3.2.3"
  }
}
