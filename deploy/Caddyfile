# Reverse proxy for BetterCad. The hostname is a placeholder until Kev picks one (#21).
# Caddy gets and renews the Let's Encrypt certificate on its own.
bettercad.kevsrobots.com {
	encode zstd gzip
	request_body {
		max_size 60MB # at least MAX_UPLOAD_MB
	}
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Strict-Transport-Security "max-age=31536000"
	}
	reverse_proxy 127.0.0.1:8000
}
