          "name": "Back rest",
          "position": {
            "x": 0,
            "y": 0,
            "z": 0
          },
          "size": {
            "x": 10,
            "y": 10,
            "z": 10
          }
        },
        "type": "add"
      },
      {
        "exprs": {
          "size.x": "lean",
          "size.y": "width",
          "size.z": "height"
        },
        "id": "f4",
        "name": "Size Back rest",
        "parts": [
          "rest"
        ],
        "size": {
          "x": 10,
          "y": 10,
          "z": 10
        },
        "type": "resize"
      },
      {
        "exprs": {
          "position.x": "lean / 2 - (lean + shelf + 4) / 2",
          "position.z": "base"
        },
        "id": "f5",
        "name": "Place Back rest",
        "parts": [
          "rest"
        ],
        "position": {
          "x": 0,
          "y": 0,
