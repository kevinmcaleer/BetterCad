      {
        "id": "f1",
        "name": "Add Phone stand",
        "part": {
          "id": "stand",
          "kind": "box",
          "name": "Phone stand",
          "position": {
            "x": 0,
            "y": 0,
            "z": 0
          },
          "size": {
            "x": 10,
            "y": 10,
            "z": 10
          }
        },
        "type": "add"
      },
      {
        "exprs": {
          "size.x": "lean + shelf + 4",
          "size.y": "width",
          "size.z": "base"
        },
        "id": "f2",
        "name": "Size Phone stand",
        "parts": [
          "stand"
        ],
        "size": {
          "x": 10,
          "y": 10,
          "z": 10
        },
        "type": "resize"
      },
