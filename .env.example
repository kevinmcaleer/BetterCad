# BetterCad settings. Copy this file to `.env` next to docker-compose.yml, fill in the
# values marked "set this", and leave the rest alone unless you know you need to change them.
#
#   cp .env.example .env
#   sed -i "s/^SECRET_KEY=.*/SECRET_KEY=$(openssl rand -hex 32)/" .env
#
# `.env` is ignored by git. Never commit it.
#
# Where each setting is read:
#   docker compose   reads this file from the repo root (or the folder holding docker-compose.yml)
#   make dev         reads `server/.env`; the defaults below work with no file at all

# --- Required in production -----------------------------------------------------------

# Signs sessions. The server refuses to start with ENV=production and no SECRET_KEY.
# Generate one with: openssl rand -hex 32   <-- set this
SECRET_KEY=

# --- Cloudflare Tunnel ----------------------------------------------------------------

# Starts the cloudflared container with the app. Remove this line to run the app on its own.
COMPOSE_PROFILES=tunnel

# The tunnel's token: Zero Trust → Networks → Tunnels → your tunnel → Configure, then copy the long string after
# --token in the install command (it starts eyJ). It is a secret: keep it out of git.   <-- set this
CLOUDFLARE_TUNNEL_TOKEN=

# --- Server ---------------------------------------------------------------------------

# development | production. The Docker image sets production for you; leave it unset for `make dev`.
# ENV=production

# Folder for the SQLite database and uploads. In Docker this is the `bettercad-data` volume at /data.
# DATA_DIR=data

# Full path of the database file. Defaults to DATA_DIR/bettercad.db.
# DATABASE_PATH=

# Largest saved model, in megabytes. Keep the reverse proxy or tunnel body limit above this (docs/deploy.md).
# MAX_UPLOAD_MB=50

# Comma-separated origins allowed by CORS. Only matters outside production; behind the proxy the app is same-origin.
# Production: https://bettercad.kevsrobots.com   Dev: http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173

# Where the built web app lives. The Docker image sets /app/web/dist; `make dev` serves it from Vite instead.
# WEB_DIST=web/dist

# Shown by /api/health. The release workflow sets it from the git tag.
# VERSION=

# --- Web (build time, Vite) -----------------------------------------------------------

# Include the component gallery (#/gallery) in a production build. It is always on in dev and preview.
# VITE_GALLERY=1

# --- Coming with later epics (not read yet) -------------------------------------------
# USER_QUOTA_MB=500        per-user storage quota (#87)
# REPORT_EMAIL=            where "Report a problem" sends (#109)
# GITHUB_REPORT_TOKEN=     or file reports as GitHub issues instead (#109)
