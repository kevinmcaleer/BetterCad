# BetterCad settings. Copy this file to `.env` next to docker-compose.yml, fill in the
# values marked "set this", and leave the rest alone unless you know you need to change them.
#
#   cp .env.example .env
#   sed -i "s/^SECRET_KEY=.*/SECRET_KEY=$(openssl rand -hex 32)/" .env
#
# `.env` is ignored by git. Never commit it.
#
# Where each setting is read:
#   docker compose   reads this file from the repo root (or the folder holding docker-compose.yml)
#   make dev         reads `server/.env`; the defaults below work with no file at all

# --- Required in production -----------------------------------------------------------

# Signs sessions. The server refuses to start with ENV=production and no SECRET_KEY.
# Generate one with: openssl rand -hex 32   <-- set this
SECRET_KEY=

# --- Cloudflare Tunnel ----------------------------------------------------------------

# cloudflared starts with the app. To run the app on its own: docker compose up -d bettercad

# The tunnel's token: Zero Trust → Networks → Tunnels → your tunnel → Configure, then copy the long string after
# --token in the install command (it starts eyJ). It is a secret: keep it out of git.   <-- set this
CLOUDFLARE_TUNNEL_TOKEN=

# --- Sign-in ---------------------------------------------------------------------------

# People sign in with their kevsrobots.com account (Chatter). Its cookie is set on .kevsrobots.com, so BetterCad must be
# served under that domain. These defaults suit bettercad.kevsrobots.com; change them only to test against another Chatter.
# CHATTER_URL=https://chatter.kevsrobots.com
# Chatter's address from this server, when it runs on the same machine: sign-in checks then skip Cloudflare, which can
# refuse them (530 or 403 in the logs). For example http://172.17.0.1:8001 (Chatter's published port on the host).
# CHATTER_API_URL=
# COOKIE_DOMAIN=.kevsrobots.com

# Where people reach BetterCad: kevsrobots.com sends them back here after signing in.
# PUBLIC_URL=https://bettercad.kevsrobots.com

# --- Server ---------------------------------------------------------------------------

# development | production. The Docker image sets production for you; leave it unset for `make dev`.
# ENV=production

# Folder for the SQLite database and uploads. In Docker this is the `bettercad-data` volume at /data.
# DATA_DIR=data

# Full path of the database file. Defaults to DATA_DIR/bettercad.db.
# DATABASE_PATH=

# Largest saved model, in megabytes. Keep the reverse proxy or tunnel body limit above this (docs/deploy.md).
# MAX_UPLOAD_MB=50

# Storage each account may use (saved models, all their versions and imported files), in megabytes.
# USER_QUOTA_MB=500

# Where nightly backups go. docker-compose mounts BACKUP_PATH on the host (default ./backups) at /backups.
# BACKUP_PATH=./backups
# BACKUP_DIR=          the folder inside the container; unset means no backups (as in `make dev`)
# BACKUP_DAYS=14

# Comma-separated origins allowed by CORS. Only matters outside production; behind the proxy the app is same-origin.
# Production: https://bettercad.kevsrobots.com   Dev: http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173

# Where the built web app lives. The Docker image sets /app/web/dist; `make dev` serves it from Vite instead.
# WEB_DIST=web/dist

# Shown by /api/health. The release workflow sets it from the git tag.
# VERSION=

# --- Web (build time, Vite) -----------------------------------------------------------

# Include the component gallery (#/gallery) in a production build. It is always on in dev and preview.
# VITE_GALLERY=1

# --- Problem reports (#109) ------------------------------------------------------------
# "Report a problem" posts to /api/report. Reports are always kept in DATA_DIR/reports/<id>/; set one of these to be told.
# Email: where to send, and the SMTP server to send through (STARTTLS on SMTP_PORT).
# REPORT_EMAIL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Or file each report as an issue in a private repository: a fine-grained token with Issues: write on that repo.
# GITHUB_REPORT_TOKEN=
# GITHUB_REPORT_REPO=owner/bettercad-reports

# --- Page counts (#111) -------------------------------------------------------------------
# The accounts (comma-separated emails) that can read /api/stats.
# STATS_EMAILS=
# The accounts (comma-separated emails) that can open the admin console (#/admin): every user and their models.
# Blank uses STATS_EMAILS.
# ADMIN_EMAILS=
